# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — Project Settings > API > service_role (secreta!)
# Usada SÓ pelo script local `npm run db:seed` (precisa da Admin API para criar
# a usuária de demonstração). Nunca é lida pelo código da aplicação — não
# definir em produção/Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — Project Settings > Database > Connection string (modo "Transaction" ou direto)
# Usada apenas por drizzle-kit (migrations) e pelo seed. Nunca exposta ao cliente.
DATABASE_URL=

# URL pública da aplicação, usada em metadata, Open Graph e links de convite/RSVP
NEXT_PUBLIC_APP_URL=http://localhost:3000
