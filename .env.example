# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — Project Settings > API > service_role (secreta!)
# Usada SÓ pelo script local `npm run db:seed` (precisa da Admin API para criar
# a usuária de demonstração). Nunca é lida pelo código da aplicação — não
# definir em produção/Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — Project Settings > Database > Connection string (modo "Transaction" ou direto)
# Usada por drizzle-kit (migrations) e pelo seed localmente, mas também em
# runtime por src/db/rls.ts — é a conexão Postgres usada em toda Server
# Action/Server Component que lê/grava dado do casamento (a role muda por
# transação via "set local role", não a connection string). Por isso, ao
# contrário de SUPABASE_SERVICE_ROLE_KEY, essa PRECISA estar configurada na
# Vercel também — sem ela, qualquer página logada quebra. Nunca exposta ao
# cliente (sem prefixo NEXT_PUBLIC_).
DATABASE_URL=

# URL pública da aplicação, usada em metadata, Open Graph e links de convite/RSVP
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe — Dashboard > Developers > API keys. Em desenvolvimento, use as
# chaves de TESTE (sk_test_/pk_test_) — troque para as de produção só
# quando o CNPJ/conta Stripe estiver validado.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Stripe — Dashboard > Developers > Webhooks. Localmente, gerado por
# `stripe listen --forward-to localhost:3000/api/stripe/webhook`; em
# produção, criado ao cadastrar o endpoint no Dashboard (URL de produção).
STRIPE_WEBHOOK_SECRET=

# Stripe — Price IDs criados uma vez via `npm run stripe:setup`
# (script em scripts/stripe-setup.ts, usa src/lib/planos.ts como fonte de
# valores) — copiar a saída do script pra cá.
STRIPE_PRICE_NOIVA=
STRIPE_PRICE_CERIMONIALISTA_BASICO=
STRIPE_PRICE_CERIMONIALISTA_PREMIUM=
STRIPE_PRICE_CERIMONIALISTA_PLATINUM=
